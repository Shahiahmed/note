# Upstash Redis (REST API)
# Create a database at https://console.upstash.com/redis and copy both values
# from the "REST API" section, then save this file as .env.local
# UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Optional: prefix for every Redis key.
# Set it (e.g. "budget:") when this app shares an Upstash database with
# another project, so the keys of the two never collide. Leave empty to
# use plain keys: transactions:{id}, user:transactions, categories, budgets:{category}
REDIS_KEY_PREFIX=
UPSTASH_REDIS_REST_URL="https://leading-hare-142484.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAiyUAAIgcDE5OWQwZDEwOTMzNGY0MDdhYjQ4YTQzYzFlZjZlMzUxNw"
# Auth (single user). Generate all three with: npm run set-password
# AUTH_PASSWORD_HASH stores a PBKDF2 hash, never the password itself.
# AUTH_SECRET signs the session cookie - keep it random and private.
AUTH_LOGIN=your-login
AUTH_PASSWORD_HASH=
AUTH_SECRET=

# Timezone used to decide what "today" is (day counters, daily spending limit).
# Vercel servers run in UTC, so leaving this unset there would shift the date
# by a few hours. Defaults to Asia/Almaty.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Almaty
